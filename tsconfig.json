{
    "compilerOptions": {
        "target": "ES6",
        "module": "ES6",
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["jest", "node"],
        "sourceMap": true,
        "esModuleInterop": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        // Recommended Options
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
